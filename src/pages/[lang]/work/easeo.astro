---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en', project: 'easeo' } },
    { params: { lang: 'es', project: 'easeo' } },
    { params: { lang: 'fr', project: 'easeo' } },
  ];
}

const { lang } = Astro.params;
---

<Layout lang={lang} route={'/' + lang + '/work/easeo'} title="easeo | Emiliano G.O." description="Deterministic SEO metadata from one Rust core with Python and Node.js bindings. Byte-for-byte identical output across languages.">
  <Nav lang={lang} />
  <main id="main" class="pt-24">

    <!-- Header -->
    <section class="py-16 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-accent) mb-2">SEO METADATA · MULTI-LANGUAGE SDK</p>
        <h1 class="font-[family-name:var(--font-display)] text-[clamp(32px,5vw,56px)] font-bold uppercase leading-[0.95] tracking-wide text-(--color-accent) mb-4">easeo</h1>
        <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[540px] mb-3">A deterministic SEO metadata generator: one Rust core with Python, Node.js, and Rust APIs.</p>
        <p class="text-xs text-(--color-text-dim) max-w-[540px] mb-6">Takes a content entity, its route, and a site config, and returns canonical URL, title, description, robots directives, Open Graph, Twitter Cards, and JSON-LD.</p>

        <div class="flex flex-wrap gap-2 mb-6">
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-border) text-(--color-text-dim)">Rust core</span>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-border) text-(--color-text-dim)">Python</span>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-border) text-(--color-text-dim)">Node.js</span>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-border) text-(--color-text-dim)">JSON-LD</span>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-border) text-(--color-text-dim)">MIT</span>
        </div>

        <div class="arch-diagram mb-6">Entity + route + config
                  │
                  ▼
        URL normalization
   (HTTPS, slashes, query allowlist)
                  │
                  ▼
        Fallback chain resolution
                  │
        ┌─────────┼─────────┬─────────┐
        ▼         ▼         ▼         ▼
     Meta      Open      Twitter   JSON-LD
   + robots    Graph      Cards    schemas
        │         │         │         │
        └─────────┼─────────┴─────────┘
                  ▼
    Payload + SHA-256 hash / ETag
                  │
                  ▼
          render_html() head snippet</div>

        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/emiliano-go/easeo" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-200">GitHub ↗</a>
          <a href="https://easeo.emiliano-go.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-200">Docs ↗</a>
          <a href="https://pypi.org/project/easeo/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-200">PyPI ↗</a>
          <a href="https://www.npmjs.com/package/@easeo/core" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-200">npm ↗</a>
          <a href="https://crates.io/crates/easeo-core" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-200">crates.io ↗</a>
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="py-12 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) mb-6">Problem</h2>
        <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[540px]">SEO libraries tend to mix metadata generation with scoring, keyword analysis, and content rewriting. The output varies run to run, which makes it hard to snapshot-test, hash, cache, or diff. Platforms that render in more than one language end up with subtly different payloads per stack.</p>
      </div>
    </section>

    <!-- Key decisions -->
    <section class="py-12 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) mb-6">Key decisions</h2>
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-(--color-text-head) mb-1">One core, three bindings</h3>
            <p class="text-xs text-(--color-text-muted)">All logic lives in easeo-core. Python and Node.js wrap the same engine, and the cross-language conformance suite asserts byte-for-byte identical output.</p>
          </div>
          <div>
            <h3 class="text-sm font-medium text-(--color-text-head) mb-1">Pure determinism</h3>
            <p class="text-xs text-(--color-text-muted)">No timestamps, randomness, environment reads, or hidden I/O. The same inputs always produce the same payload, so output can be hashed and committed.</p>
          </div>
          <div>
            <h3 class="text-sm font-medium text-(--color-text-head) mb-1">SEO contracts for CI</h3>
            <p class="text-xs text-(--color-text-muted)">build_seo_contract emits machine-readable SEO intent that can be committed and validated as code, catching metadata regressions in review.</p>
          </div>
          <div>
            <h3 class="text-sm font-medium text-(--color-text-head) mb-1">Scoped extension registries</h3>
            <p class="text-xs text-(--color-text-muted)">HookRegistry and SchemaRegistry add post-processing and custom JSON-LD without touching the core, and are scoped to a config rather than global.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Results -->
    <section class="py-12 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) mb-6">Results</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="proof-panel">
            <div class="label">Tests</div>
            <div class="item"><span class="text-(--color-accent) text-lg font-medium">310</span></div>
          </div>
          <div class="proof-panel">
            <div class="label">Entity types</div>
            <div class="item"><span class="text-(--color-accent) text-lg font-medium">11</span></div>
          </div>
          <div class="proof-panel">
            <div class="label">Integrations</div>
            <div class="item"><span class="text-(--color-accent) text-lg font-medium">10</span></div>
          </div>
          <div class="proof-panel">
            <div class="label">Docs pages</div>
            <div class="item"><span class="text-(--color-accent) text-lg font-medium">64</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tradeoffs -->
    <section class="py-12 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) mb-6">Tradeoffs</h2>
        <ul class="space-y-2 text-sm text-(--color-text-muted)">
          <li class="flex items-start gap-2"><span class="text-(--color-accent) mt-1">·</span>Not a framework: adapters marshal inputs, they do not own application lifecycle</li>
          <li class="flex items-start gap-2"><span class="text-(--color-accent) mt-1">·</span>Not a scoring, keyword-analysis, crawling, or content-rewriting tool</li>
          <li class="flex items-start gap-2"><span class="text-(--color-accent) mt-1">·</span>Renders a head snippet, not a full document; alpha release status</li>
        </ul>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>
