---
import ProjectPage from '../../../components/ProjectPage.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en', project: 'clickvault' } },
    { params: { lang: 'es', project: 'clickvault' } },
    { params: { lang: 'fr', project: 'clickvault' } },
  ];
}

const { lang } = Astro.params;
---

<ProjectPage lang={lang!} id="clickvault" />
