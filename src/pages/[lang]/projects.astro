---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import Footer from '../../components/Footer.astro';
import { createT } from '../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const t = createT(lang!);

const featured = [
  { name: 'DBWarden', desc: 'Declarative schema compiler that derives deterministic database migrations from SQLAlchemy models.', stack: ['Python', 'SQLAlchemy', 'SQL', 'PostgreSQL', 'MySQL', 'ClickHouse'], github: 'https://github.com/dbwarden-org/dbwarden', docs: 'https://docs.dbwarden.org' },
  { name: 'TrustSight', desc: 'Evidence-driven security analysis for AUR packages. Never executes code. Fail-closed by design.', stack: ['Python', 'Arch Linux', 'SQLite', 'Security'], github: 'https://github.com/emiliano-go/trustsight', docs: 'https://docs.trustsight.org' },
  { name: 'rypipe', desc: 'Reusable ingestion framework. Rust core, Python bindings. Add a new format by implementing two traits.', stack: ['Rust', 'Python', 'PyO3', 'Arrow'], github: 'https://github.com/emiliano-go/rypipe', docs: 'https://rypipe.emiliano-go.com' },
];

const projects = [
  { name: 'crxml', desc: 'Crystal Reports XML adapter built on rypipe. Rust-accelerated, parallel, bounded-memory.', stack: ['Rust', 'Python', 'XML', 'Arrow'], github: 'https://github.com/emiliano-go/crxml', pypi: 'https://pypi.org/project/crxml/' },
  { name: 'schemap', desc: 'Automatic Pydantic v2 schemas from SQLAlchemy 2.0 ORM models.', stack: ['Python', 'Pydantic', 'SQLAlchemy'], github: 'https://github.com/emiliano-go/schemap', pypi: 'https://pypi.org/project/schemap/' },
  { name: 'seoslug', desc: 'Deterministic SEO payload generation. Same input always produces the same output.', stack: ['Python', 'SEO', 'JSON-LD'], github: 'https://github.com/emiliano-go/seoslug', pypi: 'https://pypi.org/project/seoslug/' },
  { name: 'acrresolv', desc: 'Hybrid acronym resolver: rules + lookup + ML. 95.5% accuracy on unseen data.', stack: ['Python', 'NLP', 'ML'], github: 'https://github.com/emiliano-go/acrresolv', pypi: 'https://pypi.org/project/acrresolv/' },
  { name: 'detrack', desc: 'Strip tracking parameters from URLs. Deterministically. Zero dependencies.', stack: ['Python'], github: 'https://github.com/emiliano-go/detrack', pypi: 'https://pypi.org/project/detrack/' },
  { name: 'clickvault', desc: 'HashiCorp Vault database secrets engine plugin for ClickHouse.', stack: ['Go', 'Vault', 'ClickHouse'], github: 'https://github.com/emiliano-go/clickvault' },
  { name: 'interferon', desc: 'Container-native immune signaling for Docker stacks.', stack: ['Python', 'Docker', 'SSE'], github: 'https://github.com/emiliano-go/interferon' },
  { name: 'heard', desc: 'Voice-controlled tooling daemon for Linux. Hold Shift, speak, release.', stack: ['Python', 'Whisper', 'evdev', 'Linux'], github: 'https://github.com/emiliano-go/heard' },
  { name: 'mapcreator', desc: 'Tile-based building map editor with A* pathfinding.', stack: ['React', 'TypeScript', 'Canvas'], github: 'https://github.com/emiliano-go/mapcreator' },
  { name: 'dsig', desc: 'GPG message signing for Vencord / Vesktop. Authorship attestation.', stack: ['TypeScript', 'GPG'], github: 'https://github.com/emiliano-go/dsig' },
  { name: 'Equinox', desc: 'My "cold storage" of everything I learn. Published as a Quartz site.', stack: ['Obsidian', 'Quartz'], github: 'https://github.com/emiliano-go/Equinox' },
  { name: 'vigil', desc: 'Personal GitHub activity monitoring workflow built with Prefect.', stack: ['Python', 'Prefect', 'ClickHouse'], github: 'https://github.com/emiliano-go/vigil' },
];
---

<Layout lang={lang} route={'/' + lang + '/projects'} title="Projects | Emiliano G.O." description="All projects by Emiliano G.O.">
  <Nav lang={lang} />
  <main id="main" class="pt-24">

    <section class="py-16 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h1 class="font-[family-name:var(--font-display)] text-[clamp(28px,4vw,40px)] font-bold uppercase leading-[0.95] tracking-wide text-(--color-text-head) mb-4">All Projects</h1>
        <p class="text-xs text-(--color-text-muted) mb-8">Open source packages, tools, and experiments.</p>

        <!-- Featured: full-width cards -->
        <div class="flex flex-col gap-px bg-(--color-border-subtle) border border-(--color-border-subtle) mb-8">
          {featured.map((p) => (
            <a href={`/${lang}/work/${p.name.toLowerCase()}`} class="bg-(--color-bg) p-5 sm:p-6 group block hover:bg-(--color-surface) transition-colors duration-200">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
                <div>
                  <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide text-(--color-text-head) group-hover:text-(--color-accent) transition-colors duration-200">{p.name}</h3>
                  <p class="text-[11px] leading-relaxed text-(--color-text-muted) mt-1 max-w-[540px]">{p.desc}</p>
                </div>
                <div class="flex flex-wrap gap-1.5 shrink-0">
                  {p.stack.map(s => (
                    <span class="text-[9px] font-mono px-1.5 py-0.5 border border-(--color-border) text-(--color-text-dim)">{s}</span>
                  ))}
                </div>
              </div>
              <div class="flex flex-wrap gap-3">
                <span class="text-[10px] font-mono text-(--color-accent)">GitHub ↗</span>
                <span class="text-[10px] font-mono text-(--color-accent)">Docs ↗</span>
                <span class="text-[10px] font-mono text-(--color-text-muted) group-hover:text-(--color-text-bright)">Explore →</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Other projects: 2-column grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
          {projects.map((p) => (
            <div class="bg-(--color-bg) p-5 flex flex-col">
              <h3 class="font-[family-name:var(--font-mono)] text-sm font-medium text-(--color-text-head) mb-2">{p.name}</h3>
              <p class="text-[11px] leading-relaxed text-(--color-text-muted) flex-1 mb-3">{p.desc}</p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {p.stack.map(s => (
                  <span class="text-[9px] font-mono px-1.5 py-0.5 border border-(--color-border) text-(--color-text-dim)">{s}</span>
                ))}
              </div>
              <div class="flex flex-wrap gap-2">
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-(--color-accent) hover:text-(--color-text-bright) transition-colors duration-200">GitHub ↗</a>
                {p.pypi && (
                  <a href={p.pypi} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-(--color-accent) hover:text-(--color-text-bright) transition-colors duration-200">PyPI ↗</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Ecosystem lang={lang} />

  </main>
  <Footer lang={lang} />
</Layout>
