---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import Footer from '../../components/Footer.astro';
import { createT, type Lang } from '../../i18n';
import { getProject } from '../../data/projects';
import { secondary } from '../../data/catalog';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = createT(lang);

const caseStudyIds = [
  'dbwarden',
  'trustsight',
  'rypipe',
  'kestrel',
  'postal',
  'neurafly',
  'easeo',
  'clickvault',
  'dsig',
  'xmlstreamer-ng',
  'eclipse',
];
const promotedIds = ['crxml', 'totem', 'RBG', 'gpg-mcp'];
const promotedAccents: Record<string, [string, string]> = {
  crxml: ['#c96a50', '#9b4a32'],
  totem: ['#8a7bd8', '#4b3d99'],
  RBG: ['#7387e0', '#4d5ec0'],
  'gpg-mcp': ['#3f9e8a', '#26695c'],
};

const caseStudies = caseStudyIds.map((id) => ({ ...getProject(id, lang), external: false }));
const promoted = secondary
  .filter((project) => promotedIds.includes(project.id))
  .map((project) => ({
    id: project.id,
    name: project.name,
    summary: project.desc[lang],
    stack: project.stack,
    links: project.links,
    accent: promotedAccents[project.id][0],
    accentLight: promotedAccents[project.id][1],
    external: true,
  }));
const featured = [...caseStudies, ...promoted];
const others = secondary
  .filter((project) => !promotedIds.includes(project.id))
  .map((project) => ({ ...project, desc: project.desc[lang] }));
---

<Layout lang={lang} route={'/' + lang + '/projects'} title={t('projects.page.title')} description={t('projects.page.desc')}>
  <Nav lang={lang} />
  <main id="main" class="pt-24">

    <section class="py-16 border-b border-(--color-border-subtle)">
      <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">
        <h1 class="font-[family-name:var(--font-display)] text-[clamp(28px,4vw,40px)] font-bold uppercase leading-[0.95] tracking-wide text-(--color-text-head) mb-4">{t('projects.page.heading')}</h1>
        <p class="text-xs text-(--color-text-muted) mb-8">{t('projects.page.desc')}</p>

        <!-- Featured: full-width cards -->
        <div class="flex flex-col gap-px bg-(--color-border-subtle) border border-(--color-border-subtle) mb-8">
          {featured.map((p) => (
            <a href={p.external ? p.links[0].href : `/${lang}/work/${p.id}`} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined} class="project-accent bg-(--color-bg) p-5 sm:p-6 group block hover:bg-(--color-surface) transition-colors duration-100 border-l-2" style={`--accent-dark: ${p.accent}; --accent-light: ${p.accentLight}; border-left-color: var(--accent)`}>
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
                <div>
                  <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide transition-colors duration-100" style="color: var(--accent)">{p.name}</h3>
                  <p class="text-[11px] leading-relaxed text-(--color-text-muted) mt-1 max-w-[540px]">{p.summary}</p>
                </div>
                <div class="flex flex-wrap gap-1.5 shrink-0">
                  {p.stack.map(s => (
                    <span class="text-[9px] font-mono px-1.5 py-0.5 border border-(--color-border) text-(--color-text-dim)">{s}</span>
                  ))}
                </div>
              </div>
              <div class="flex flex-wrap gap-3">
                {p.external ? (
                  <span class="text-[10px] font-mono" style="color: var(--accent)">{p.links[0].label} ↗</span>
                ) : (
                  <>
                    {p.links.slice(0, 2).map((link) => (
                      <span class="text-[10px] font-mono" style="color: var(--accent)">{link.label} ↗</span>
                    ))}
                    <span class="text-[10px] font-mono text-(--color-text-muted) group-hover:text-(--color-text-bright)">{t('projects.explore')} →</span>
                  </>
                )}
              </div>
            </a>
          ))}
        </div>

        <!-- Secondary projects: 2-column grid -->
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4 mt-8">{t('projects.other')}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
          {others.map((p) => (
            <div class="bg-(--color-bg) p-5 flex flex-col">
              <h3 class="font-[family-name:var(--font-mono)] text-sm font-medium text-(--color-text-head) mb-2">{p.name}</h3>
              <p class="text-[11px] leading-relaxed text-(--color-text-muted) flex-1 mb-3">{p.desc}</p>
              <div class="flex flex-wrap gap-1.5 mb-3">
                {p.stack.map(s => (
                  <span class="text-[9px] font-mono px-1.5 py-0.5 border border-(--color-border) text-(--color-text-dim)">{s}</span>
                ))}
              </div>
              <div class="flex flex-wrap gap-2">
                {p.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-(--color-accent) hover:text-(--color-text-bright) transition-colors duration-100">{link.label} ↗</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Ecosystem lang={lang} />

  </main>
  <Footer lang={lang} />
</Layout>
