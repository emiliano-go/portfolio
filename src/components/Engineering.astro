---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);
---

<section id="engineering" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("engineering.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[540px] mb-10">
      {t("engineering.intro")}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
      {[
        { key: 'explicit-state' },
        { key: 'determinism' },
        { key: 'fail-closed' },
        { key: 'reproducibility' },
        { key: 'separation' },
        { key: 'evidence' },
      ].map((p) => (
        <div class="bg-(--color-bg) p-5">
          <h3 class="font-[family-name:var(--font-mono)] text-xs font-medium text-(--color-text-bright) mb-2">{t(`engineering.principle.${p.key}.title`)}</h3>
          <p class="text-xs leading-relaxed text-(--color-text-muted)">{t(`engineering.principle.${p.key}.desc`)}</p>
        </div>
      ))}
    </div>

  </div>
</section>
