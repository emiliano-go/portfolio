---

<section id="about" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("about.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <p class="text-sm leading-relaxed text-(--color-text-muted) mb-6">{t("about.bio")}</p>
        <div class="mb-6">
          <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-2">{t("about.current")}</p>
          <p class="text-xs leading-relaxed text-(--color-text-muted)">{t("about.current.desc")}</p>
        </div>
        <div class="mb-6">
          <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-2">{t("about.interests")}</p>
          <p class="text-xs font-mono leading-relaxed text-(--color-text-muted)">{t("about.interests.desc")}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="https://github.com/emiliano-go" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">GitHub <span class="text-[8px]" aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/emiliano-go" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">LinkedIn <span class="text-[8px]" aria-hidden="true">↗</span></a>
          <a href="https://blog.emiliano-go.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">Blog <span class="text-[8px]" aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">Stack</p>
        <div class="grid grid-cols-2 gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
          {stack.map((item) => {
            const icon = iconPaths[item.icon];
            return (
              <div class="bg-(--color-bg) flex items-center gap-2 px-3 py-2.5">
                <svg class="w-4 h-4 shrink-0 text-(--color-text-dim)" viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
                  <path d={icon.path}/>
                </svg>
                <span class="text-[11px] text-(--color-text-muted)">{item.name}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>

  </div>
</section>
