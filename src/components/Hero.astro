---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);
---

<section class="relative min-h-[100svh] pt-24 pb-12 flex items-center">
  <canvas id="hero-ascii" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0 relative z-10">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Left: hero content -->
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-[clamp(40px,7vw,72px)] font-bold uppercase leading-[0.92] tracking-wide text-(--color-text-head) mb-4">
          Emiliano G.O.
        </h1>

        <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[540px] mb-3">
          {t("hero.role")}
        </p>

        <p class="text-[11px] font-mono text-(--color-text-dim) mb-8">
          Montevideo, Uruguay · Python · Rust · SQL
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/emiliano-go" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[11px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">
            GitHub <span class="text-[8px]" aria-hidden="true">↗</span>
          </a>
          <a href="https://www.linkedin.com/in/emiliano-go" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[11px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">
            LinkedIn <span class="text-[8px]" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Right: activity (desktop only) -->
      <div class="hidden md:block">
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">{t("activity.recent")}</p>
        <div id="hero-commits" class="space-y-0 mb-6">
          <div class="flex items-center gap-2 py-2 border-b border-(--color-border-subtle)">
            <span class="inline-block h-3 w-20 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-40 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
          <div class="flex items-center gap-2 py-2 border-b border-(--color-border-subtle)">
            <span class="inline-block h-3 w-16 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-32 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
          <div class="flex items-center gap-2 py-2">
            <span class="inline-block h-3 w-24 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-36 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
        </div>

        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-3">{t("activity.languages")}</p>
        <div id="hero-lang-bar"></div>
        <p class="text-[9px] font-mono text-(--color-text-dim) mt-2 italic">{t("activity.lang.note")}</p>
      </div>
    </div>

  </div>

  <div id="hero-scroll" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2" style="opacity: 0;">
    <span class="text-[9px] font-mono text-(--color-text-dim) tracking-widest uppercase">scroll</span>
    <svg width="16" height="24" viewBox="0 0 16 24" fill="none" class="text-(--color-text-dim) animate-[bounce_2s_ease-in-out_infinite]">
      <rect x="1" y="1" width="14" height="22" rx="7" stroke="currentColor" stroke-width="1.5"/>
      <line x1="8" y1="6" x2="8" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </div>
</section>

<script is:inline>
  if (!window.__astroHeroInit) {
  window.__astroHeroInit = true;
  (function() {
    var canvas = document.getElementById('hero-ascii');
    if (canvas && canvas.getContext) {
      var ctx = canvas.getContext('2d');
      var dpr = window.devicePixelRatio || 1;
      var fontSize = 10;
      var cellW = fontSize * 0.62;
      var cellH = fontSize;
      var cols, rows, dims, phases;
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function resize() {
        var rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
        ctx.scale(dpr, dpr);
        cols = Math.ceil(rect.width / cellW);
        rows = Math.ceil(rect.height / cellH);
        dims = [];
        phases = [];
        for (var i = 0; i < cols * rows; i++) {
          dims[i] = 0.2 + Math.random() * 0.8;
          phases[i] = Math.random() * Math.PI * 2;
        }
      }

      var chars = '/\\|_-~=+<>{}[]()#*^:.';

      function draw(time) {
        var w = canvas.width / dpr;
        var h = canvas.height / dpr;
        ctx.clearRect(0, 0, w, h);
        var isLight = document.documentElement.classList.contains('light');
        var color = isLight ? '30,40,55' : '140,160,180';
        var baseAlpha = isLight ? 0.4 : 0.3;
        ctx.font = fontSize + 'px monospace';
        ctx.textBaseline = 'top';
        var t = time * 0.001;
        var idx = 0;
        for (var r = 0; r < rows; r++) {
          var rowFade = r / rows > 0.7 ? 1 - Math.pow((r / rows - 0.7) / 0.3, 2) : 1;
          for (var c = 0; c < cols; c++) {
            var wave = Math.sin(t * 0.3 + phases[idx]);
            var ci = Math.floor((wave * 0.5 + 0.5) * chars.length) % chars.length;
            var fadeAlpha = Math.abs(wave);
            ctx.fillStyle = 'rgba(' + color + ',' + (baseAlpha * dims[idx] * fadeAlpha * rowFade) + ')';
            ctx.fillText(chars[ci], c * cellW, r * cellH);
            idx++;
          }
        }
      }

      var raf;
      function loop(time) {
        draw(time);
        if (!reducedMotion) raf = requestAnimationFrame(loop);
      }

      resize();
      window.addEventListener('resize', resize);
      if (reducedMotion) {
        draw(0);
      } else {
        raf = requestAnimationFrame(loop);
      }
    }

    var el = document.getElementById('hero-scroll');
    if (el) {
      setTimeout(function() { el.style.transition = 'opacity 0.4s ease'; el.style.opacity = '1'; }, 1500);
      var hidden = false;
      window.addEventListener('scroll', function() {
        var y = window.scrollY || window.pageYOffset;
        if (!hidden && y > 40) { el.style.opacity = '0'; hidden = true; }
        else if (hidden && y <= 40) { el.style.opacity = '1'; hidden = false; }
      }, { passive: true });
    }

    function ago(iso) {
      if (!iso) return '';
      var now = Date.now();
      var then = new Date(iso.endsWith('Z') ? iso : iso + 'Z').getTime();
      var diff = now - then;
      if (diff < 0) return '';
      if (diff < 60000) return 'just now';
      var mins = Math.floor(diff / 60000);
      if (mins < 60) return mins + 'm ago';
      var hrs = Math.floor(mins / 60);
      if (hrs < 24) return hrs + 'h ago';
      var days = Math.floor(hrs / 24);
      if (days < 7) return days + 'd ago';
      if (days < 30) return Math.floor(days / 7) + 'w ago';
      return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    fetch('/api/katib?endpoint=commits')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var container = document.getElementById('hero-commits');
        if (!container || !data.commits || data.commits.length === 0) return;

        var html = '';
        var commits = data.commits.slice(0, 3);
        for (var i = 0; i < commits.length; i++) {
          var c = commits[i];
          var repo = c.repo || '';
          var msg = (c.message || '').split('\n')[0];
          var date = c.date || '';
          var url = c.url || ('https://github.com/emiliano-go/' + repo + '/commit/' + (c.sha || ''));
          html += '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 py-2 border-b border-(--color-border-subtle) hover:bg-(--color-surface) transition-colors duration-150 -mx-2 px-2">';
          html += '<span class="font-[family-name:var(--font-mono)] text-[11px] text-(--color-accent) shrink-0 w-20 truncate">' + repo + '</span>';
          html += '<span class="font-[family-name:var(--font-mono)] text-[11px] text-(--color-text-muted) flex-1 truncate">' + msg + '</span>';
          html += '<span class="font-[family-name:var(--font-mono)] text-[10px] text-(--color-text-dim) shrink-0 whitespace-nowrap">' + (date ? ago(date) : '') + '</span>';
          html += '</a>';
        }
        container.innerHTML = html;

        var langContainer = document.getElementById('hero-lang-bar');
        var languages = data.languages || [];
        if (langContainer && languages.length > 0) {
          var total = 0;
          for (var j = 0; j < languages.length; j++) total += languages[j].size || 0;
          if (total > 0) {
            var barHtml = '<div class="relative"><div class="flex h-2 rounded-sm overflow-hidden bg-(--color-border-subtle)">';
            for (var k = 0; k < languages.length; k++) {
              var lang = languages[k];
              var pct = (lang.size / total) * 100;
              if (pct < 1 && k >= 5) break;
              barHtml += '<div class="hero-lang-seg h-full cursor-default" data-lang="' + (lang.name || '') + '" data-pct="' + Math.round(pct) + '" style="width:' + pct + '%;background:' + (lang.color || '#5ba3a8') + '"></div>';
            }
            barHtml += '</div><div id="hero-lang-tooltip" class="absolute bottom-full left-0 mb-1 px-1.5 py-0.5 bg-(--color-surface) border border-(--color-border) text-[9px] font-mono text-(--color-text-muted) rounded opacity-0 pointer-events-none whitespace-nowrap z-10 transition-opacity duration-150"></div></div>';
            langContainer.innerHTML = barHtml;

            var tip = document.getElementById('hero-lang-tooltip');
            var barWrapper = tip.parentElement;
            var segs = langContainer.querySelectorAll('.hero-lang-seg');
            for (var m = 0; m < segs.length; m++) {
              segs[m].addEventListener('mouseenter', function(e) {
                tip.textContent = this.dataset.lang + ' ' + this.dataset.pct + '%';
                var rect = this.getBoundingClientRect();
                var parent = barWrapper.getBoundingClientRect();
                tip.style.left = (rect.left - parent.left + rect.width / 2) + 'px';
                tip.style.transform = 'translateX(-50%)';
                tip.style.opacity = '1';
              });
              segs[m].addEventListener('mouseleave', function() {
                tip.style.opacity = '0';
              });
            }
          }
        }
      })
      .catch(function() {});
  })();
  }
</script>

<style>
  #hero-ascii {
    -webkit-mask-image: radial-gradient(ellipse 65% 65% at 30% 50%, transparent 0%, black 80%);
    mask-image: radial-gradient(ellipse 65% 65% at 30% 50%, transparent 0%, black 80%);
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
</style>
