---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);
const email = 'e@emiliano-go.com';
// Keep the address out of the served HTML so simple scrapers cannot harvest it.
const emailToken = Buffer.from(email, 'utf8').toString('base64');
---

<section class="relative min-h-[100svh] pt-24 pb-12 flex items-center">
  <canvas id="hero-ascii" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0 relative z-10">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Left: hero content -->
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-[clamp(40px,7vw,72px)] font-bold uppercase leading-[0.92] tracking-wide text-(--color-text-head) mb-4">
          Emiliano G.O.
        </h1>

        <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[540px] mb-3">
          {t("hero.role")}
        </p>

        <p class="text-xs font-mono text-(--color-accent) max-w-[540px] mb-6">
          {t("hero.stack")}
        </p>

        <p class="text-xs font-mono text-(--color-text-dim) mb-6">
          {t("hero.stat.location")}
        </p>

        <div class="flex flex-wrap gap-3 mb-8">
          <a href={`/${Astro.props.lang || 'en'}/work/trustsight`} class="inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 border border-(--color-accent) text-(--color-accent) hover:bg-(--color-accent) hover:text-(--color-bg) transition-colors duration-100">
            {t("hero.cta.work")} <span aria-hidden="true">→</span>
          </a>
          <button type="button" data-copy-email-token={emailToken} aria-label={t("hero.cta.contact.aria")} class="inline-flex cursor-pointer items-center gap-1.5 text-xs font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-100">
            {t("hero.cta.contact")}
          </button>
        </div>

      </div>

      <!-- Right: activity (desktop only) -->
      <div class="hidden md:block">
        <p class="text-xs font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">{t("activity.recent")}</p>
        <div id="hero-commits" class="space-y-0 mb-6" data-unavailable={t("activity.unavailable")}>
          <div class="flex items-center gap-2 py-2 border-b border-(--color-border-subtle)">
            <span class="inline-block h-3 w-20 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-40 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
          <div class="flex items-center gap-2 py-2 border-b border-(--color-border-subtle)">
            <span class="inline-block h-3 w-16 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-32 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
          <div class="flex items-center gap-2 py-2">
            <span class="inline-block h-3 w-24 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
            <span class="inline-block h-3 w-36 bg-(--color-text-dim)/10 rounded animate-pulse"></span>
          </div>
        </div>

        <p class="text-xs font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-3">{t("activity.languages")}</p>
        <div id="hero-lang-bar"></div>
        <p class="text-xs font-mono text-(--color-text-dim) mt-2">{t("activity.lang.note")}</p>
      </div>
    </div>

  </div>

  <div id="hero-scroll" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2" style="opacity: 0;">
    <span class="text-xs font-mono text-(--color-text-dim) tracking-widest uppercase">{t("hero.scroll")}</span>
    <svg width="16" height="24" viewBox="0 0 16 24" fill="none" class="text-(--color-text-dim)">
      <rect x="1" y="1" width="14" height="22" rx="7" stroke="currentColor" stroke-width="1.5"/>
      <line x1="8" y1="6" x2="8" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </div>
</section>

<script is:inline>
  (function() {
    function initHero() {
      if (window.__astroHeroCleanup) {
        window.__astroHeroCleanup();
        window.__astroHeroCleanup = null;
      }

      var cleanups = [];
      var raf = 0;
      var revealTimer = 0;

      var canvas = document.getElementById('hero-ascii');
      if (canvas && canvas.getContext) {
        var ctx = canvas.getContext('2d');
        var dpr = window.devicePixelRatio || 1;
        var fontSize = 10;
        var cellW = fontSize * 0.62;
        var cellH = fontSize;
        var cols, rows, dims, phases;
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function resize() {
          var rect = canvas.parentElement.getBoundingClientRect();
          canvas.width = rect.width * dpr;
          canvas.height = rect.height * dpr;
          canvas.style.width = rect.width + 'px';
          canvas.style.height = rect.height + 'px';
          ctx.scale(dpr, dpr);
          cols = Math.ceil(rect.width / cellW);
          rows = Math.ceil(rect.height / cellH);
          dims = [];
          phases = [];
          for (var i = 0; i < cols * rows; i++) {
            dims[i] = 0.2 + Math.random() * 0.8;
            phases[i] = Math.random() * Math.PI * 2;
          }
        }

        var chars = '/\\|_-~=+<>{}[]()#*^:.';

        function draw(time) {
          var w = canvas.width / dpr;
          var h = canvas.height / dpr;
          ctx.clearRect(0, 0, w, h);
          var isLight = document.documentElement.classList.contains('light');
          var color = isLight ? '30,40,55' : '140,160,180';
          var baseAlpha = isLight ? 0.4 : 0.3;
          ctx.font = fontSize + 'px monospace';
          ctx.textBaseline = 'top';
          var t = time * 0.001;
          var idx = 0;
          for (var r = 0; r < rows; r++) {
            var rowFade = r / rows > 0.7 ? 1 - Math.pow((r / rows - 0.7) / 0.3, 2) : 1;
            for (var c = 0; c < cols; c++) {
              var wave = Math.sin(t * 0.3 + phases[idx]);
              var ci = Math.floor((wave * 0.5 + 0.5) * chars.length) % chars.length;
              var fadeAlpha = Math.abs(wave);
              ctx.fillStyle = 'rgba(' + color + ',' + (baseAlpha * dims[idx] * fadeAlpha * rowFade) + ')';
              ctx.fillText(chars[ci], c * cellW, r * cellH);
              idx++;
            }
          }
        }

        function loop(time) {
          draw(time);
          if (!reducedMotion) raf = requestAnimationFrame(loop);
        }

        resize();
        window.addEventListener('resize', resize);
        cleanups.push(function() { window.removeEventListener('resize', resize); });
        if (reducedMotion) {
          draw(0);
        } else {
          raf = requestAnimationFrame(loop);
        }
      }

      var el = document.getElementById('hero-scroll');
      if (el) {
        revealTimer = setTimeout(function() { el.style.transition = 'opacity 0.4s ease'; el.style.opacity = '1'; }, 1500);
        var hidden = false;
        var onScroll = function() {
          var y = window.scrollY || window.pageYOffset;
          if (!hidden && y > 40) { el.style.opacity = '0'; hidden = true; }
          else if (hidden && y <= 40) { el.style.opacity = '1'; hidden = false; }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        cleanups.push(function() { window.removeEventListener('scroll', onScroll); });
      }

      var commitEl = document.getElementById('hero-commits');
      var langEl = document.getElementById('hero-lang-bar');

      function ago(iso) {
        if (!iso) return '';
        var now = Date.now();
        var then = new Date(iso.endsWith('Z') ? iso : iso + 'Z').getTime();
        var diff = now - then;
        if (diff < 0) return '';
        if (diff < 60000) return 'just now';
        var mins = Math.floor(diff / 60000);
        if (mins < 60) return mins + 'm ago';
        var hrs = Math.floor(mins / 60);
        if (hrs < 24) return hrs + 'h ago';
        var days = Math.floor(hrs / 24);
        if (days < 7) return days + 'd ago';
        if (days < 30) return Math.floor(days / 7) + 'w ago';
        return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      }

      function showUnavailable() {
        if (!commitEl || !commitEl.isConnected) return;
        commitEl.innerHTML = '<p class="text-xs text-(--color-text-dim)">' + commitEl.dataset.unavailable + '</p>';
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (char) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
        });
      }

      function layoutLangChart(chart) {
        if (!chart || !chart.isConnected) return;
        var labelsLayer = chart.querySelector('[data-lang-labels]');
        var svg = chart.querySelector('svg');
        var bar = chart.querySelector('[data-lang-bar]');
        if (!labelsLayer || !svg || !bar) return;

        var chartRect = chart.getBoundingClientRect();
        var barRect = bar.getBoundingClientRect();
        var width = chartRect.width;
        var height = chartRect.height;
        var barTop = barRect.top - chartRect.top;
        var barBottom = barRect.bottom - chartRect.top;
        var labels = labelsLayer.querySelectorAll('[data-lang-label]');
        var sides = { above: [], below: [] };

        for (var i = 0; i < labels.length; i++) {
          var el = labels[i];
          sides[el.dataset.side].push({
            el: el,
            center: (parseFloat(el.dataset.center) / 100) * width,
            width: el.offsetWidth,
          });
        }

        var lines = '';
        ['above', 'below'].forEach(function (side) {
          var items = sides[side].sort(function (a, b) { return a.center - b.center; });
          var lastEnd = [-9999, -9999];
          for (var j = 0; j < items.length; j++) {
            var item = items[j];
            var desired = item.center - item.width / 2;
            var left = Math.max(0, Math.min(desired, width - item.width));
            var row = 0;
            if (left < lastEnd[0] + 8) row = 1;
            if (row === 1 && left < lastEnd[1] + 8) row = lastEnd[0] <= lastEnd[1] ? 0 : 1;
            lastEnd[row] = left + item.width;

            var top = side === 'above'
              ? barTop - 28 - row * 20 - item.el.offsetHeight
              : barBottom + 28 + row * 20;
            item.el.style.left = left + 'px';
            item.el.style.top = top + 'px';

            var anchorY = side === 'above' ? barTop - 28 - row * 20 : top;
            lines += '<line x1="' + (left + item.width / 2) + '" y1="' + anchorY
              + '" x2="' + item.center + '" y2="' + (side === 'above' ? barTop : barBottom)
              + '" stroke="var(--color-text-dim)" stroke-opacity="0.5" stroke-width="1"/>';
          }
        });

        svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
        svg.innerHTML = lines;
        labelsLayer.style.opacity = '1';
      }

      function renderLanguages(data) {
        if (!langEl || !langEl.isConnected) return;
        var languages = (data && data.languages) || [];
        if (!languages.length) return;

        var sorted = languages.slice().sort(function (a, b) { return (b.size || 0) - (a.size || 0); });
        var total = 0;
        for (var i = 0; i < sorted.length; i++) total += sorted[i].size || 0;
        if (total <= 0) return;

        var maxLabels = window.matchMedia('(min-width: 1280px)').matches ? 7 : 5;
        var chosen = sorted.slice(0, maxLabels);
        if (sorted.length > maxLabels) {
          chosen = sorted.slice(0, maxLabels - 1);
          var other = 0;
          for (var j = maxLabels - 1; j < sorted.length; j++) other += sorted[j].size || 0;
          chosen.push({ name: 'Other', size: other, color: '#5e6a7e' });
        }

        var segments = [];
        var summary = [];
        var cumulative = 0;
        for (var k = 0; k < chosen.length; k++) {
          var lang = chosen[k];
          var pct = ((lang.size || 0) / total) * 100;
          var color = lang.name === 'Rust' ? '#D34516' : (/^#[0-9a-fA-F]{3,8}$/.test(lang.color || '') ? lang.color : '#5ba3a8');
          segments.push({ name: lang.name || 'Other', pct: pct, color: color, center: cumulative + pct / 2 });
          summary.push((lang.name || 'Other') + ' ' + Math.round(pct) + '%');
          cumulative += pct;
        }

        var barHtml = '';
        var labelsHtml = '';
        for (var n = 0; n < segments.length; n++) {
          var segment = segments[n];
          barHtml += '<div class="h-full" style="width:' + segment.pct + '%;background:' + segment.color + '"></div>';
          labelsHtml += '<span class="absolute whitespace-nowrap font-mono text-xs leading-4 text-(--color-text-muted)" data-lang-label data-center="' + segment.center + '" data-side="' + (n % 2 === 0 ? 'above' : 'below') + '" style="left:0;top:0">' + escapeHtml(segment.name) + '</span>';
        }

        langEl.innerHTML =
          '<div class="relative py-20" data-lang-chart>'
          + '<svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></svg>'
          + '<div class="relative flex h-1.5 overflow-hidden rounded-sm bg-(--color-border-subtle)" data-lang-bar role="img" aria-label="' + escapeHtml(summary.join(', ')) + '">'
          + barHtml
          + '</div>'
          + '<div class="pointer-events-none absolute inset-0 transition-opacity duration-150" data-lang-labels style="opacity:0" aria-hidden="true">'
          + labelsHtml
          + '</div>'
          + '</div>';

        var chart = langEl.querySelector('[data-lang-chart]');
        requestAnimationFrame(function () { layoutLangChart(chart); });
        var onResize = function () { layoutLangChart(chart); };
        window.addEventListener('resize', onResize);
        cleanups.push(function () { window.removeEventListener('resize', onResize); });
      }

      fetch('/api/katib?endpoint=commits')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          renderLanguages(data);
          if (!commitEl || !commitEl.isConnected) return;
          if (!data || !data.commits || data.commits.length === 0) {
            showUnavailable();
            return;
          }

          var html = '';
          var commits = data.commits.slice(0, 3);
          for (var i = 0; i < commits.length; i++) {
            var c = commits[i];
            var repo = c.repo || '';
            var msg = (c.message || '').split('\n')[0];
            var date = c.date || '';
            var url = c.url || ('https://github.com/emiliano-go/' + repo + '/commit/' + (c.sha || ''));
            html += '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 py-2 border-b border-(--color-border-subtle) hover:bg-(--color-surface) transition-colors duration-75 -mx-2 px-2">';
            html += '<span class="font-[family-name:var(--font-mono)] text-xs text-(--color-accent) shrink-0 w-20 truncate">' + repo + '</span>';
            html += '<span class="font-[family-name:var(--font-mono)] text-xs text-(--color-text-muted) flex-1 truncate">' + msg + '</span>';
            html += '<span class="font-[family-name:var(--font-mono)] text-xs text-(--color-text-dim) shrink-0 whitespace-nowrap">' + (date ? ago(date) : '') + '</span>';
            html += '</a>';
          }
          commitEl.innerHTML = html;
        })
        .catch(showUnavailable);

      window.__astroHeroCleanup = function() {
        if (raf) cancelAnimationFrame(raf);
        if (revealTimer) clearTimeout(revealTimer);
        for (var i = 0; i < cleanups.length; i++) cleanups[i]();
      };
    }

    document.addEventListener('astro:page-load', initHero);
    if (document.readyState === 'complete') initHero();
  })();
</script>

<style>
  #hero-ascii {
    -webkit-mask-image: radial-gradient(ellipse 65% 65% at 30% 50%, transparent 0%, black 80%);
    mask-image: radial-gradient(ellipse 65% 65% at 30% 50%, transparent 0%, black 80%);
  }
</style>
