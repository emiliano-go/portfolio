---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);

const ecosystem = [
  {
    name: 'dbwarden-harness',
    descKey: 'ecosystem.dbwarden-harness.desc',
    tagKey: 'ecosystem.dbwarden-harness.tag',
  },
  {
    name: 'wlite',
    descKey: 'ecosystem.wlite.desc',
    tagKey: 'ecosystem.wlite.tag',
  },
  {
    name: 'libwlite',
    descKey: 'ecosystem.libwlite.desc',
    tagKey: 'ecosystem.libwlite.tag',
  },
  {
    name: 'dbwarden-redis',
    descKey: 'ecosystem.dbwarden-redis.desc',
    tagKey: 'ecosystem.dbwarden-redis.tag',
  },
  {
    name: 'dbwarden-fastapi',
    descKey: 'ecosystem.dbwarden-fastapi.desc',
    tagKey: 'ecosystem.dbwarden-fastapi.tag',
  },
  {
    name: 'dbwarden-ch-rbac',
    descKey: 'ecosystem.dbwarden-ch-rbac.desc',
    tagKey: 'ecosystem.dbwarden-ch-rbac.tag',
  },
  {
    name: 'dbwarden-pgsql-types',
    descKey: 'ecosystem.dbwarden-pgsql-types.desc',
    tagKey: 'ecosystem.dbwarden-pgsql-types.tag',
  },
  {
    name: 'dbwarden-pgsql-rbac',
    descKey: 'ecosystem.dbwarden-pgsql-rbac.desc',
    tagKey: 'ecosystem.dbwarden-pgsql-rbac.tag',
  },
  {
    name: 'dbwarden-pgsql-extensions',
    descKey: 'ecosystem.dbwarden-pgsql-extensions.desc',
    tagKey: 'ecosystem.dbwarden-pgsql-extensions.tag',
  },
  {
    name: 'dbwarden-plugin-template',
    descKey: 'ecosystem.dbwarden-plugin-template.desc',
    tagKey: 'ecosystem.dbwarden-plugin-template.tag',
  },
  {
    name: 'dbwarden-seeds',
    descKey: 'ecosystem.dbwarden-seeds.desc',
    tagKey: 'ecosystem.dbwarden-seeds.tag',
  },
  {
    name: 'dbwarden-sandbox',
    descKey: 'ecosystem.dbwarden-sandbox.desc',
    tagKey: 'ecosystem.dbwarden-sandbox.tag',
  },
];
---

<section id="ecosystem" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("ecosystem.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <p class="text-xs leading-relaxed text-(--color-text-muted) mb-8 max-w-[540px]">
      {t("ecosystem.intro")}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
      {ecosystem.map((p) => (
        <a
          href={`https://github.com/dbwarden-org/${p.name}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-(--color-bg) p-4 hover:bg-(--color-surface) transition-colors duration-100 group"
        >
          <p class="text-[9px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-1">{t(p.tagKey)}</p>
          <h3 class="font-[family-name:var(--font-mono)] text-xs font-medium text-(--color-text-bright) mb-1 group-hover:text-(--color-accent) transition-colors duration-100">{p.name}</h3>
          <p class="text-[11px] leading-relaxed text-(--color-text-muted)">{t(p.descKey)}</p>
        </a>
      ))}
    </div>

  </div>
</section>
