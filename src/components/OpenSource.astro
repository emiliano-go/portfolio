---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);
---

<section id="opensource" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("opensource.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <div class="space-y-6">

      <!-- LibreCourseUY -->
      <div class="border border-(--color-border-subtle) bg-(--color-surface) p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
          <div>
            <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-1">OPEN SOURCE · URUGUAY</p>
            <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide text-(--color-text-head)">LibreCourseUY</h3>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-accent-muted) text-(--color-accent) self-start">Director</span>
        </div>
        <p class="text-xs leading-relaxed text-(--color-text-muted) mb-4">An open source organization focused on promoting the FOSS ecosystem in Uruguay. 400+ members. We build and maintain free tools, services, and infrastructure for the Uruguayan developer community.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/LibreCourseUY" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">GitHub ↗</a>
          <a href="https://librecourse.uy" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">Website ↗</a>
        </div>
      </div>

      <!-- FastAPI-boilerplate -->
      <div class="border border-(--color-border-subtle) bg-(--color-surface) p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
          <div>
            <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-1">OPEN SOURCE · PYTHON</p>
            <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide text-(--color-text-head)">FastAPI-boilerplate</h3>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 border border-(--color-accent-muted) text-(--color-accent) self-start">Co-maintainer</span>
        </div>
        <p class="text-xs leading-relaxed text-(--color-text-muted) mb-4">Batteries-included async FastAPI starter. Auth (sessions, OAuth, API keys), FastCRUD, Alembic, Taskiq workers, Redis caching, and per-tier rate limiting. Named co-maintainer in v0.18.0, the pluggable restructure release.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/benavlabs/FastAPI-boilerplate" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border border-(--color-border) text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200">GitHub ↗</a>
        </div>
      </div>

    </div>

  </div>
</section>
