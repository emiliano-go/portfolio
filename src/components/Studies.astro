---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);

const groups = [
  {
    label: t("studies.career"),
    rows: [
      {
        title: t("studies.career.1.title"),
        place: `${t("studies.career.1.institution")} · ${t("studies.career.1.spec")}`,
        period: t("studies.career.1.period"),
        ongoing: true,
      },
      {
        title: t("studies.career.2.title"),
        place: t("studies.career.2.institution"),
        period: t("studies.career.2.period"),
        ongoing: true,
      },
    ],
  },
  {
    label: t("studies.edu.heading"),
    rows: [
      {
        title: t("studies.edu.1.field"),
        place: `${t("studies.edu.1.institution")} · ${t("studies.edu.1.degree")}`,
        period: t("studies.edu.1.period"),
        ongoing: false,
      },
      {
        title: t("studies.edu.2.field"),
        place: t("studies.edu.2.institution"),
        period: t("studies.edu.2.period"),
        ongoing: false,
      },
    ],
  },
  {
    label: t("studies.cert.heading"),
    rows: [
      {
        title: t("studies.cert.1.course"),
        place: t("studies.cert.1.platform"),
        period: t("studies.cert.1.completed"),
        ongoing: false,
      },
    ],
  },
];

const rows = groups.flatMap((group) =>
  group.rows.map((row) => ({ ...row, group: group.label }))
);
---

<section id="studies" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("studies.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <div class="flex flex-col gap-px border border-(--color-border-subtle) bg-(--color-border-subtle)">
      {rows.map((row) => (
        <div
          class:list={[
            "border-l-2 bg-(--color-bg) p-5 sm:p-7",
            row.ongoing ? "border-(--color-accent)" : "border-(--color-border)",
          ]}
        >
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-8">
            <div class="shrink-0 lg:w-48">
              <p class="font-mono text-xs text-(--color-text-dim)">{row.period}</p>
              <p class="mt-1 font-mono text-xs uppercase tracking-[0.12em] text-(--color-text-dim)">{row.group}</p>
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide text-(--color-text-head) md:text-2xl">{row.title}</h3>
              <p class="mt-2 max-w-[480px] text-xs text-(--color-text-muted)">{row.place}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
