---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);
---

<section id="studies" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("studies.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Career -->
      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">{t("studies.career")}</p>
        <div class="space-y-4">
          <div class="border-l-2 border-(--color-accent-muted) pl-4">
            <h3 class="text-sm font-medium text-(--color-text-head)">{t("studies.career.1.title")}</h3>
            <p class="text-[11px] font-mono text-(--color-accent)">{t("studies.career.1.spec")}</p>
            <p class="text-[11px] text-(--color-text-muted)">{t("studies.career.1.institution")}</p>
            <p class="text-[10px] font-mono text-(--color-text-dim)">{t("studies.career.1.period")}</p>
          </div>
          <div class="border-l-2 border-(--color-border) pl-4">
            <h3 class="text-sm font-medium text-(--color-text-head)">{t("studies.career.2.title")}</h3>
            <p class="text-[11px] text-(--color-text-muted)">{t("studies.career.2.institution")}</p>
            <p class="text-[10px] font-mono text-(--color-text-dim)">{t("studies.career.2.period")}</p>
          </div>
        </div>
      </div>

      <!-- Education + Certs -->
      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">{t("studies.edu.heading")}</p>
        <div class="space-y-3 mb-6">
          <div class="border-l-2 border-(--color-border) pl-4">
            <h3 class="text-sm font-medium text-(--color-text-head)">{t("studies.edu.1.institution")}</h3>
            <p class="text-[11px] text-(--color-text-muted)">{t("studies.edu.1.degree")}, {t("studies.edu.1.field")}</p>
            <p class="text-[10px] font-mono text-(--color-text-dim)">{t("studies.edu.1.period")}</p>
          </div>
          <div class="border-l-2 border-(--color-border) pl-4">
            <h3 class="text-sm font-medium text-(--color-text-head)">{t("studies.edu.2.institution")}</h3>
            <p class="text-[11px] text-(--color-text-muted)">{t("studies.edu.2.degree")}, {t("studies.edu.2.field")}</p>
            <p class="text-[10px] font-mono text-(--color-text-dim)">{t("studies.edu.2.period")}</p>
          </div>
        </div>

        <p class="text-[10px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-4">{t("studies.cert.heading")}</p>
        <div class="border-l-2 border-(--color-border) pl-4">
          <h3 class="text-sm font-medium text-(--color-text-head)">{t("studies.cert.1.course")}</h3>
          <p class="text-[11px] text-(--color-text-muted)">{t("studies.cert.1.platform")}</p>
          <p class="text-[10px] font-mono text-(--color-text-dim)">{t("studies.cert.1.completed")}</p>
        </div>
      </div>

    </div>

  </div>
</section>
