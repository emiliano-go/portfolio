---
import { createT } from '../i18n';
const t = createT(Astro.props.lang);

const projects = [
  {
    id: 'dbwarden',
    num: '01',
    category: 'DATABASE INFRASTRUCTURE',
    name: 'DBWarden',
    accent: '#b39d6a',
    desc: 'Declarative schema compiler that derives deterministic database migrations from SQLAlchemy models. 5 DB backends, 8 plugins, release-certification harness.',
    diagram: 'Models → IR → Diff → SQL → Verification',
    facts: ['45K LOC', '129 test files', '5 databases', 'Release harness'],
    links: [
      { label: 'GitHub', href: 'https://github.com/dbwarden-org/dbwarden' },
      { label: 'Docs', href: 'https://docs.dbwarden.org' },
    ],
  },
  {
    id: 'trustsight',
    num: '02',
    category: 'SECURITY · STATIC ANALYSIS',
    name: 'TrustSight',
    accent: '#0092d2',
    desc: 'Evidence-driven security analysis for AUR packages. Never executes code. Fail-closed by design. Corpus-wide cluster detection across 180K source URLs.',
    diagram: 'Diff → Static analysis → Evidence + coverage → Risk assessment → Verdict',
    facts: ['1,943 tests', '~200 rules', 'Signed baselines', 'IOC federation'],
    links: [
      { label: 'GitHub', href: 'https://github.com/emiliano-go/trustsight' },
      { label: 'Docs', href: 'https://docs.trustsight.org' },
    ],
  },
  {
    id: 'rypipe',
    num: '03',
    category: 'DATA · INGESTION FRAMEWORK',
    name: 'rypipe',
    accent: '#af4f37',
    desc: 'Reusable ingestion framework. Rust core, Python bindings. Add a new format by implementing two traits. Published to PyPI and crates.io.',
    diagram: 'Format Adapter → Splitter / Parser → Execution Plan → Parallel Engine → Arrow',
    facts: ['319 tests', '13K docs', 'PyPI + crates.io', '4.2 GB/s parallel'],
    links: [
      { label: 'GitHub', href: 'https://github.com/emiliano-go/rypipe' },
      { label: 'Docs', href: 'https://rypipe.emiliano-go.com' },
    ],
  },
  {
    id: 'heard',
    num: '04',
    category: 'VOICE · LINUX DAEMON',
    name: 'heard',
    accent: '#6b2fa0',
    desc: 'Voice-controlled tooling daemon for Linux. Hold Shift, speak, release. Deployed on real hardware with systemd and GNOME Shell extension.',
    diagram: 'PTT → Whisper STT → Embedding classifier → Tool dispatch → Shell/Hyprland/Media',
    facts: ['299 tests', 'Deployed', 'Systemd unit', 'GNOME extension'],
    links: [
      { label: 'GitHub', href: 'https://github.com/emiliano-go/heard' },
    ],
  },
  {
    id: 'clickvault',
    num: '05',
    category: 'SECURITY · VAULT PLUGIN',
    name: 'ClickVault',
    accent: '#f5c81b',
    desc: 'HashiCorp Vault database secrets engine plugin for ClickHouse. Dynamic credentials, password rotation, cluster-aware DDL.',
    diagram: 'Vault API → Plugin → ClickHouse dynamic users → Short-lived credentials → Rotation',
    facts: ['85% coverage', 'Code enforced', 'Cluster-aware', 'TLS support'],
    links: [
      { label: 'GitHub', href: 'https://github.com/emiliano-go/clickvault' },
    ],
  },
  {
    id: 'more',
    num: '→',
    category: '',
    name: 'More projects',
    desc: 'crxml, dsig, schemap, seoslug, detrack, dbwarden-harness, and more.',
    diagram: '',
    facts: [],
    links: [
      { label: 'View all', href: `/${Astro.props.lang || 'en'}/projects` },
    ],
  },
];
---

<section id="work" class="py-16 border-b border-(--color-border-subtle)">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0">

    <div class="flex items-center gap-4 mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-text-dim) whitespace-nowrap">{t("work.heading")}</h2>
      <div class="flex-1 h-px bg-(--color-border-subtle)"></div>
    </div>

    <div class="flex flex-col gap-px bg-(--color-border-subtle) border border-(--color-border-subtle)">
      {projects.map((p) => {
        const isMore = p.id === 'more';
        const href = isMore ? `/${Astro.props.lang}/projects` : `/${Astro.props.lang}/work/${p.id}`;
        return (
          <a href={href} class:list={[
            "p-5 sm:p-7 group block transition-colors duration-200 border-l-2",
            isMore ? "bg-(--color-surface) hover:bg-(--color-bg) border-l-(--color-border)" : "bg-(--color-bg) hover:bg-(--color-surface)"
          ]} style={!isMore && p.accent ? `--accent: ${p.accent}; border-left-color: ${p.accent}` : undefined}>
            <div class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-8">
              <div class="lg:w-48 shrink-0">
                <span class="font-[family-name:var(--font-mono)] text-[10px]" style={!isMore && p.accent ? `color: ${p.accent}` : undefined}>{p.num}</span>
                {p.category && <p class="text-[9px] font-mono uppercase tracking-[0.12em] mt-1 mb-1" style={!isMore && p.accent ? `color: ${p.accent}` : undefined}>{p.category}</p>}
                <h3 class:list={[
                  "font-[family-name:var(--font-display)] font-bold uppercase tracking-wide transition-colors duration-200",
                  isMore ? "text-xl text-(--color-text-muted) group-hover:text-(--color-text-bright) mt-1" : "text-2xl md:text-3xl text-(--color-text-head) group-hover:text-[var(--accent,var(--color-accent))]"
                ]}>{p.name}</h3>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs leading-relaxed text-(--color-text-muted) mb-4 max-w-[480px]">{p.desc}</p>
                {p.diagram && <div class="arch-diagram mb-4 text-[10px]">{p.diagram}</div>}
                {p.facts.length > 0 && (
                  <div class="flex flex-wrap items-center gap-2 mb-4">
                    {p.facts.map(f => (
                      <span class="text-[10px] font-mono px-2 py-0.5 border text-(--color-text-dim)" style={!isMore && p.accent ? `border-color: ${p.accent}40` : undefined}>{f}</span>
                    ))}
                  </div>
                )}
                <div class="flex flex-wrap gap-3">
                  {p.links.map(link => (
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono px-3 py-1.5 border transition-colors duration-200" style={!isMore && p.accent ? `border-color: ${p.accent}; color: ${p.accent}` : undefined}>
                      {link.label} <span class="text-[8px]" aria-hidden="true">{isMore ? '→' : '↗'}</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</section>
