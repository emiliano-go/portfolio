---
import { createT } from '../i18n';

const { lang } = Astro.props as { lang: string };
const t = createT(lang);

const links = [
  { href: '/' + lang + '/#about', key: 'nav.about' },
  { href: '/' + lang + '/#engineering', key: 'nav.engineering' },
  { href: '/' + lang + '/projects', key: 'nav.projects' },
  { href: '/' + lang + '/#studies', key: 'nav.studies' },
  { href: 'https://github.com/emiliano-go', external: true, key: 'nav.github' },
];

const langOptions = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'fr', label: 'Français' },
];
---

<header>
<nav
  id="nav"
  aria-label={t("a11y.nav")}
  class="fixed top-0 left-0 right-0 z-50 border-b border-(--color-border-subtle) opacity-0 bg-(--color-bg)/95"
  style="backdrop-filter: blur(12px);"
>
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0 flex items-center justify-between py-5">
    <a href={'/' + lang} class="font-[family-name:var(--font-display)] text-xl font-bold tracking-widest uppercase text-(--color-text-head)">EMILIANO G.O.</a>
    <ul class="hidden md:flex md:gap-5 lg:gap-7 list-none">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="nav-link text-[11px] font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200"
          >{t(link.key)}</a>
        </li>
      ))}
      <li class="flex items-center gap-2">
        <div class="relative" id="lang-dd-wrap">
          <button
            type="button"
            id="lang-dd-btn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="lang-dd-desk"
            aria-label={t("a11y.lang")}
            class="flex items-center gap-1 px-2 py-1 border border-(--color-border) rounded text-[10px] font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200 cursor-pointer"
          >
            {lang.toUpperCase()} <span class="text-[8px]" aria-hidden="true">▾</span>
          </button>
          <div class="absolute right-0 top-full mt-1 min-w-[68px] bg-(--color-bg) border border-(--color-border) shadow-lg opacity-0 pointer-events-none transition-opacity duration-150 z-50" id="lang-dd-desk" inert>
            {langOptions.filter((o) => o.code !== lang).map((o) => (
              <a
                href={'/' + o.code}
                hreflang={o.code}
                lang={o.code}
                aria-label={o.label}
                data-lang={o.code}
                class="block px-3 py-1.5 text-[10px] font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) hover:bg-(--color-border-subtle) transition-colors duration-150"
              >{o.code.toUpperCase()}</a>
            ))}
          </div>
        </div>
        <button id="theme-toggle-desktop" class="flex items-center px-2 py-1 border border-(--color-border) rounded text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200 cursor-pointer" aria-label="Toggle theme">
          <svg id="sun-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg id="moon-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <div class="relative" id="a11y-dd-wrap">
          <button id="a11y-btn" class="flex items-center px-2 py-1 border border-(--color-border) rounded text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200 cursor-pointer" aria-label="Accessibility settings" aria-haspopup="true" aria-expanded="false">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="4.5" r="2.5"/><path d="M12 7v5m0 0l-3 7m3-7l3 7M6 10.5h12"/></svg>
          </button>
          <div id="a11y-dd" class="absolute right-0 top-full mt-1 w-40 bg-(--color-bg) border border-(--color-border) shadow-lg opacity-0 pointer-events-none transition-opacity duration-150 z-50">
            <div class="p-2.5 space-y-2.5">
              <button id="a11y-toggle-contrast" class="flex items-center justify-between w-full text-[10px] font-mono text-(--color-text-muted) hover:text-(--color-text-bright) cursor-pointer">
                <span>High contrast</span>
                <span id="a11y-contrast-dot" class="w-2 h-2 rounded-full bg-(--color-border)"></span>
              </button>
              <button id="a11y-toggle-font" class="flex items-center justify-between w-full text-[10px] font-mono text-(--color-text-muted) hover:text-(--color-text-bright) cursor-pointer">
                <span>Larger text</span>
                <span id="a11y-font-dot" class="w-2 h-2 rounded-full bg-(--color-border)"></span>
              </button>
            </div>
          </div>
        </div>
      </li>
    </ul>
    <div class="md:hidden flex items-center gap-2">
      <button id="theme-toggle-mobile" class="text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200 cursor-pointer" aria-label="Toggle theme">
        <svg id="sun-icon-mobile" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg id="moon-icon-mobile" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button id="a11y-btn-mobile" class="text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200 cursor-pointer" aria-label="Accessibility settings">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="4.5" r="2.5"/><path d="M12 7v5m0 0l-3 7m3-7l3 7M6 10.5h12"/></svg>
      </button>
      <button
        id="menu-btn"
        class="flex flex-col gap-1.5 p-2 cursor-pointer relative z-10"
        aria-label={t("a11y.menu.open")}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t("a11y.menu.open")}
        data-label-close={t("a11y.menu.close")}
      >
        <span class="block w-5 h-px bg-(--color-text-muted) transition-all duration-200"></span>
        <span class="block w-5 h-px bg-(--color-text-muted) transition-all duration-200"></span>
        <span class="block w-5 h-px bg-(--color-text-muted) transition-all duration-200"></span>
      </button>
    </div>
  </div>
</nav>

<div id="a11y-dd-mobile" class="hidden fixed bottom-20 left-4 right-4 bg-(--color-bg) border border-(--color-border) shadow-lg z-50 p-3">
  <p class="text-[9px] font-mono uppercase tracking-[0.1em] text-(--color-text-dim) mb-2">Accessibility</p>
  <button id="a11y-toggle-contrast-m" class="flex items-center justify-between w-full text-[11px] font-mono text-(--color-text-muted) py-1.5 cursor-pointer">
    <span>High contrast</span>
    <span id="a11y-contrast-dot-m" class="w-2.5 h-2.5 rounded-full bg-(--color-border)"></span>
  </button>
  <button id="a11y-toggle-font-m" class="flex items-center justify-between w-full text-[11px] font-mono text-(--color-text-muted) py-1.5 cursor-pointer">
    <span>Larger text</span>
    <span id="a11y-font-dot-m" class="w-2.5 h-2.5 rounded-full bg-(--color-border)"></span>
  </button>
</div>

<div id="mobile-menu" class="md:hidden fixed inset-0 z-40 pt-20 opacity-0 pointer-events-none transition-opacity duration-300 bg-(--color-bg)" inert>
  <button id="menu-close" class="absolute top-6 right-[7.5%] md:hidden text-(--color-text-muted) hover:text-(--color-text-bright) text-2xl cursor-pointer" aria-label={t("a11y.menu.close")}>✕</button>
  <ul class="flex flex-col items-center gap-8 pt-16 list-none">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class="text-lg font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200"
        >{t(link.key)}</a>
      </li>
    ))}
    <li class="flex items-center justify-center gap-4">
      <div class="flex items-center gap-2" id="mobile-lang-links">
        {langOptions.map((o) => (
          <a
            href={'/' + o.code}
            hreflang={o.code}
            lang={o.code}
            aria-label={o.label}
            aria-current={o.code === lang ? 'true' : undefined}
            class="inline-flex items-center min-h-[44px] px-3 py-1.5 text-lg font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200"
            data-lang={o.code}
          >{o.code.toUpperCase()}</a>
        ))}
      </div>
      <button id="theme-toggle-overlay" class="flex items-center gap-2 text-lg font-mono tracking-wide text-(--color-text-muted) hover:text-(--color-text-bright) transition-colors duration-200 cursor-pointer" aria-label="Toggle theme">
        <svg id="sun-icon-overlay" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg id="moon-icon-overlay" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </li>
  </ul>
</div>
</header>

<script is:inline>
if (!window.__astroNavInit) {
window.__astroNavInit = true;

  function currentPath() {
    var p = location.pathname;
    var m = p.match(/^\/(en|es|fr)(\/.*)?$/);
    return m ? (m[2] || '/') : p;
  }

  function retargetLangLinks(root) {
    if (!root) return;
    var cp = currentPath();
    root.querySelectorAll('a[data-lang]').forEach(function(a) {
      a.href = '/' + a.getAttribute('data-lang') + cp;
    });
  }

  function updateIcons() {
    var isLight = document.documentElement.classList.contains('light');
    document.querySelectorAll('[id^="sun-icon"]').forEach(function(el) { el.classList.toggle('hidden', !isLight); });
    document.querySelectorAll('[id^="moon-icon"]').forEach(function(el) { el.classList.toggle('hidden', isLight); });
  }

  function setTheme(light) {
    if (light) {
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.remove('light');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();
  }

  function updateDots() {
    var c = document.documentElement.getAttribute('data-contrast') === 'high';
    var f = document.documentElement.getAttribute('data-fontsize');
    var d1 = document.getElementById('a11y-contrast-dot');
    var d2 = document.getElementById('a11y-font-dot');
    var d1m = document.getElementById('a11y-contrast-dot-m');
    var d2m = document.getElementById('a11y-font-dot-m');
    if (d1) d1.style.background = c ? 'var(--color-accent)' : 'var(--color-border)';
    if (d2) d2.style.background = f ? 'var(--color-accent)' : 'var(--color-border)';
    if (d1m) d1m.style.background = c ? 'var(--color-accent)' : 'var(--color-border)';
    if (d2m) d2m.style.background = f ? 'var(--color-accent)' : 'var(--color-border)';
  }

  function saveA11y() {
    localStorage.setItem('a11y', JSON.stringify({
      contrast: document.documentElement.getAttribute('data-contrast') || 'normal',
      fontsize: document.documentElement.getAttribute('data-fontsize') || 'normal'
    }));
  }

  function toggleContrast() {
    var el = document.documentElement;
    if (el.getAttribute('data-contrast') === 'high') el.removeAttribute('data-contrast');
    else el.setAttribute('data-contrast', 'high');
    saveA11y(); updateDots();
  }

  function toggleFont() {
    var el = document.documentElement;
    if (el.getAttribute('data-fontsize')) el.removeAttribute('data-fontsize');
    else el.setAttribute('data-fontsize', 'large');
    saveA11y(); updateDots();
  }

  function setMenu(open) {
    var menuBtn = document.getElementById('menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    var menuClose = document.getElementById('menu-close');
    if (!menuBtn || !mobileMenu) return;
    var bars = menuBtn.querySelectorAll('span');
    mobileMenu.classList.toggle('opacity-100', open);
    mobileMenu.classList.toggle('pointer-events-auto', open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('pointer-events-none', !open);
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuBtn.setAttribute('aria-label', menuBtn.getAttribute(open ? 'data-label-close' : 'data-label-open'));
    if (open) mobileMenu.removeAttribute('inert');
    else mobileMenu.setAttribute('inert', '');
    if (open) {
      bars[0].style.transform = 'translateY(7px) rotate(45deg)';
      bars[1].style.transform = 'scaleX(0)';
      bars[2].style.transform = 'translateY(-7px) rotate(-45deg)';
      if (menuClose) menuClose.focus();
    } else {
      bars.forEach(function(b) { b.style.transform = ''; b.style.backgroundColor = ''; });
    }
  }

  function setDesktopDD(open) {
    var desktopDD = document.getElementById('lang-dd-desk');
    var ddBtn = document.getElementById('lang-dd-btn');
    if (!desktopDD || !ddBtn) return;
    desktopDD.classList.toggle('opacity-100', open);
    desktopDD.classList.toggle('pointer-events-auto', open);
    desktopDD.classList.toggle('opacity-0', !open);
    desktopDD.classList.toggle('pointer-events-none', !open);
    ddBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) desktopDD.removeAttribute('inert');
    else desktopDD.setAttribute('inert', '');
  }

  // Single delegated click handler for ALL interactive elements
  document.addEventListener('click', function(e) {
    var t = e.target;

    // Theme toggle (any)
    if (t.closest('[id^="theme-toggle"]')) {
      setTheme(!document.documentElement.classList.contains('light'));
      return;
    }

    // Desktop language dropdown button
    if (t.closest('#lang-dd-btn')) {
      e.stopPropagation();
      var ddBtn = document.getElementById('lang-dd-btn');
      setDesktopDD(ddBtn.getAttribute('aria-expanded') !== 'true');
      return;
    }

    // Desktop language dropdown: click outside closes
    var ddWrap = document.getElementById('lang-dd-wrap');
    if (ddWrap && !ddWrap.contains(t)) {
      setDesktopDD(false);
    }

    // Desktop a11y button
    if (t.closest('#a11y-btn')) {
      e.stopPropagation();
      var btn = document.getElementById('a11y-btn');
      var dd = document.getElementById('a11y-dd');
      if (btn && dd) {
        var open = dd.style.opacity === '1';
        dd.style.opacity = open ? '0' : '1';
        dd.style.pointerEvents = open ? 'none' : 'auto';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      }
      return;
    }

    // Desktop a11y: click outside closes
    var a11yDd = document.getElementById('a11y-dd');
    var a11yBtn = document.getElementById('a11y-btn');
    if (a11yBtn && a11yDd && !a11yBtn.contains(t) && !a11yDd.contains(t)) {
      a11yDd.style.opacity = '0';
      a11yDd.style.pointerEvents = 'none';
      a11yBtn.setAttribute('aria-expanded', 'false');
    }

    // Mobile a11y button
    if (t.closest('#a11y-btn-mobile')) {
      var ddM = document.getElementById('a11y-dd-mobile');
      if (ddM) ddM.classList.toggle('hidden');
      return;
    }

    // Mobile a11y: click outside closes
    var btnM = document.getElementById('a11y-btn-mobile');
    var ddM2 = document.getElementById('a11y-dd-mobile');
    if (btnM && ddM2 && !btnM.contains(t) && !ddM2.contains(t)) {
      ddM2.classList.add('hidden');
    }

    // A11y toggle buttons
    if (t.closest('#a11y-toggle-contrast') || t.closest('#a11y-toggle-contrast-m')) {
      toggleContrast();
      return;
    }
    if (t.closest('#a11y-toggle-font') || t.closest('#a11y-toggle-font-m')) {
      toggleFont();
      return;
    }

    // Mobile menu open
    if (t.closest('#menu-btn')) {
      var menuBtn = document.getElementById('menu-btn');
      setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
      return;
    }

    // Mobile menu close
    if (t.closest('#menu-close')) {
      var menuBtn2 = document.getElementById('menu-btn');
      setMenu(false);
      if (menuBtn2) menuBtn2.focus();
      return;
    }
  });

  // Mobile menu links close the menu
  document.getElementById('mobile-menu')?.addEventListener('click', function(e) {
    if (e.target.closest('a')) setMenu(false);
  });

  // Keyboard: Escape closes things
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var menuBtn = document.getElementById('menu-btn');
      if (menuBtn && menuBtn.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuBtn.focus();
      }
      var ddBtn = document.getElementById('lang-dd-btn');
      if (ddBtn && ddBtn.getAttribute('aria-expanded') === 'true') {
        setDesktopDD(false);
        ddBtn.focus();
      }
      var a11yDd = document.getElementById('a11y-dd');
      var a11yBtn = document.getElementById('a11y-btn');
      if (a11yBtn && a11yDd && a11yBtn.getAttribute('aria-expanded') === 'true') {
        a11yDd.style.opacity = '0';
        a11yDd.style.pointerEvents = 'none';
        a11yBtn.setAttribute('aria-expanded', 'false');
      }
    }
  });

  // Scroll: nav border
  window.addEventListener('scroll', function() {
    var nav = document.getElementById('nav');
    if (nav) nav.style.borderBottomColor = window.scrollY > 40 ? 'var(--color-border)' : 'var(--color-border-subtle)';
  }, { passive: true });

  // Language dropdown focusout
  var ddWrap = document.getElementById('lang-dd-wrap');
  if (ddWrap) {
    ddWrap.addEventListener('focusout', function(e) {
      if (!ddWrap.contains(e.relatedTarget)) setDesktopDD(false);
    });
  }

  // State updates that run on every page load
  document.addEventListener('astro:page-load', function() {
    var desktopDD = document.getElementById('lang-dd-desk');
    retargetLangLinks(desktopDD);
    var mobileLinks = document.getElementById('mobile-lang-links');
    retargetLangLinks(mobileLinks);
    var curLang = document.documentElement.lang || 'en';
    if (mobileLinks) {
      mobileLinks.querySelectorAll('a').forEach(function(a) {
        a.style.fontWeight = a.getAttribute('data-lang') === curLang ? 'bold' : '';
      });
    }
    updateIcons();
    updateDots();
  });
}
</script>

<style>
  @keyframes nav-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  #nav {
    animation: nav-fade-in 0.6s ease-out 0.3s forwards;
  }

  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 1px;
    background: var(--color-text-bright);
    transition: width 0.25s ease, left 0.25s ease;
  }
  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }
</style>
