---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import barlowBoldUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { createT } from '../i18n';
import Seo from '../components/Seo.astro';

export interface Props {
  lang: string;
  route?: string;
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const t = createT(lang);

const pageTitle = title ?? t('meta.default.title');
const pageDesc = description ?? t('meta.default.desc');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0c0e" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={barlowBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <ClientRouter />
    <Seo route={route ?? Astro.url.pathname} fallbackTitle={pageTitle} fallbackDescription={pageDesc} lang={lang} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <link rel="preconnect" href="https://blog.emiliano-go.com" />
    <link rel="prefetch" href={`/${lang}/projects`} />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (stored === 'light' || (!stored && prefersLight)) {
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
        }
        var a11y = localStorage.getItem('a11y');
        if (a11y) {
          try {
            var s = JSON.parse(a11y);
            if (s.contrast === 'high') document.documentElement.setAttribute('data-contrast', 'high');
            if (s.fontsize === 'large' || s.fontsize === 'xlarge') document.documentElement.setAttribute('data-fontsize', s.fontsize);
          } catch(e) {}
        }
        if (!window.__astroThemeInit) {
          window.__astroThemeInit = true;
          document.addEventListener('astro:page-load', function() {
            var stored = localStorage.getItem('theme');
            var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
            if (stored === 'light' || (!stored && prefersLight)) {
              document.documentElement.classList.add('light');
            } else {
              document.documentElement.classList.remove('light');
            }
            var a11y = localStorage.getItem('a11y');
            if (a11y) {
              try {
                var s = JSON.parse(a11y);
                if (s.contrast === 'high') document.documentElement.setAttribute('data-contrast', 'high');
                if (s.fontsize === 'large' || s.fontsize === 'xlarge') document.documentElement.setAttribute('data-fontsize', s.fontsize);
              } catch(e) {}
            }
          });
        }
      })();
    </script>
  </head>
  <body class="bg-(--color-bg) font-[family-name:var(--font-body)] text-(--color-text-base) antialiased">
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <div id="i18n-wrapper" class="i18n-show">
      <slot />
    </div>

    <script is:inline>
      (function () {
        if (window.__astroEmailToast) return;
        window.__astroEmailToast = true;

        function copyText(text, done) {
          function fallback() {
            var area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.top = '-1000px';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            var ok = false;
            try {
              ok = document.execCommand('copy');
            } catch (error) {
              ok = false;
            }
            document.body.removeChild(area);
            done(ok);
          }

          if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function () {
              done(true);
            }, fallback);
          } else {
            fallback();
          }
        }

        function showToast(email, ok) {
          var toast = document.getElementById('copy-email-toast');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'copy-email-toast';
            toast.className = 'copy-toast fixed bottom-4 left-4 right-4 z-[60] flex items-start gap-3 border border-(--color-border-subtle) border-l-2 bg-(--color-surface)/85 backdrop-blur-md px-4 py-3 text-xs text-(--color-text-muted) shadow-lg sm:bottom-6 sm:left-auto sm:right-6 sm:max-w-[380px]';
            toast.style.borderLeftColor = 'var(--color-accent)';
            toast.setAttribute('role', 'status');
            toast.setAttribute('aria-live', 'polite');
            toast.innerHTML = '<p class="min-w-0 flex-1 break-all"><span data-toast-label></span> <span class="font-mono text-(--color-text-bright)" data-toast-email></span></p>'
              + '<button type="button" data-toast-close aria-label="Close" class="shrink-0 cursor-pointer text-(--color-text-dim) transition-colors duration-150 hover:text-(--color-text-bright)">'
              + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>'
              + '</button>';
            document.body.appendChild(toast);
            toast.querySelector('[data-toast-close]').addEventListener('click', function () {
              toast.remove();
            });
          }

          toast.querySelector('[data-toast-label]').textContent = ok ? 'Copied email:' : 'Copy failed:';
          toast.querySelector('[data-toast-email]').textContent = email;
          var close = toast.querySelector('[data-toast-close]');
          if (close) close.focus({ preventScroll: true });
        }

        document.addEventListener('click', function (event) {
          var target = event.target instanceof Element ? event.target.closest('[data-copy-email-token]') : null;
          if (!target) return;
          var token = target.getAttribute('data-copy-email-token') || '';
          if (!token) return;
          var email = '';
          try {
            email = atob(token);
          } catch (error) {
            return;
          }
          if (!email) return;
          event.preventDefault();
          copyText(email, function (ok) {
            showToast(email, ok);
          });
        });
      })();
    </script>
  </body>
</html>
