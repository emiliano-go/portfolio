---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import barlowBoldUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { createT } from '../i18n';
import Seo from '../components/Seo.astro';

export interface Props {
  lang: string;
  route?: string;
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const t = createT(lang);

const pageTitle = title ?? t('meta.default.title');
const pageDesc = description ?? t('meta.default.desc');

// scripts/generate_markdown.py writes an index.md twin next to every built
// index.html; the alternate link advertises it so agents can skip negotiation.
const currentPath = Astro.url.pathname;
const markdownHref = currentPath.endsWith('.html')
  ? undefined
  : `${currentPath.endsWith('/') ? currentPath : `${currentPath}/`}index.md`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0c0e" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={barlowBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown" />}
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="service-doc" type="text/markdown" href="/api.md" />
    <ClientRouter />
    <Seo route={route ?? Astro.url.pathname} fallbackTitle={pageTitle} fallbackDescription={pageDesc} lang={lang} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <link rel="preconnect" href="https://blog.emiliano-go.com" />
    <link rel="prefetch" href={`/${lang}/projects`} />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (stored === 'light' || (!stored && prefersLight)) {
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
        }
        var a11y = localStorage.getItem('a11y');
        if (a11y) {
          try {
            var s = JSON.parse(a11y);
            if (s.contrast === 'high') document.documentElement.setAttribute('data-contrast', 'high');
            if (s.fontsize === 'large' || s.fontsize === 'xlarge') document.documentElement.setAttribute('data-fontsize', s.fontsize);
          } catch(e) {}
        }
        if (!window.__astroThemeInit) {
          window.__astroThemeInit = true;
          document.addEventListener('astro:page-load', function() {
            var stored = localStorage.getItem('theme');
            var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
            if (stored === 'light' || (!stored && prefersLight)) {
              document.documentElement.classList.add('light');
            } else {
              document.documentElement.classList.remove('light');
            }
            var a11y = localStorage.getItem('a11y');
            if (a11y) {
              try {
                var s = JSON.parse(a11y);
                if (s.contrast === 'high') document.documentElement.setAttribute('data-contrast', 'high');
                if (s.fontsize === 'large' || s.fontsize === 'xlarge') document.documentElement.setAttribute('data-fontsize', s.fontsize);
              } catch(e) {}
            }
          });
        }
      })();
    </script>
  </head>
  <body class="bg-(--color-bg) font-[family-name:var(--font-body)] text-(--color-text-base) antialiased">
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <div id="i18n-wrapper" class="i18n-show">
      <slot />
    </div>

    <script is:inline>
      (function () {
        if (window.__astroEmailToast) return;
        window.__astroEmailToast = true;

        function copyText(text, done) {
          function fallback() {
            var area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.top = '-1000px';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            var ok = false;
            try {
              ok = document.execCommand('copy');
            } catch (error) {
              ok = false;
            }
            document.body.removeChild(area);
            done(ok);
          }

          if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function () {
              done(true);
            }, fallback);
          } else {
            fallback();
          }
        }

        function showToast(email, ok) {
          var toast = document.getElementById('copy-email-toast');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'copy-email-toast';
            toast.className = 'copy-toast fixed bottom-4 left-4 right-4 z-[60] flex items-start gap-3 border border-(--color-border-subtle) border-l-2 bg-(--color-surface)/85 backdrop-blur-md px-4 py-3 text-xs text-(--color-text-muted) shadow-lg sm:bottom-6 sm:left-auto sm:right-6 sm:max-w-[380px]';
            toast.style.borderLeftColor = 'var(--color-accent)';
            toast.setAttribute('role', 'status');
            toast.setAttribute('aria-live', 'polite');
            toast.innerHTML = '<p class="min-w-0 flex-1 break-all"><span data-toast-label></span> <span class="font-mono text-(--color-text-bright)" data-toast-email></span></p>'
              + '<button type="button" data-toast-close aria-label="Close" class="shrink-0 cursor-pointer text-(--color-text-dim) transition-colors duration-150 hover:text-(--color-text-bright)">'
              + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>'
              + '</button>';
            document.body.appendChild(toast);
            toast.querySelector('[data-toast-close]').addEventListener('click', function () {
              toast.remove();
            });
          }

          toast.querySelector('[data-toast-label]').textContent = ok ? 'Copied email:' : 'Copy failed:';
          toast.querySelector('[data-toast-email]').textContent = email;
          var close = toast.querySelector('[data-toast-close]');
          if (close) close.focus({ preventScroll: true });
        }

        document.addEventListener('click', function (event) {
          var target = event.target instanceof Element ? event.target.closest('[data-copy-email-token]') : null;
          if (!target) return;
          var token = target.getAttribute('data-copy-email-token') || '';
          if (!token) return;
          var email = '';
          try {
            email = atob(token);
          } catch (error) {
            return;
          }
          if (!email) return;
          event.preventDefault();
          copyText(email, function (ok) {
            showToast(email, ok);
          });
        });
      })();
    </script>

    <!-- WebMCP: expose the site's read-only actions to browser agents. The API is
         feature-detected (document.modelContext, older builds navigator.modelContext);
         nothing runs when it is absent. Data comes from /mcp/catalog.json and
         /llms.txt, the same sources the MCP endpoint uses. -->
    <script is:inline>
      (function () {
        var mc = (typeof document !== 'undefined' && document.modelContext)
          || (typeof navigator !== 'undefined' && navigator.modelContext);
        if (!mc || typeof mc.registerTool !== 'function') return;
        if (window.__webmcpRegistered) return;
        window.__webmcpRegistered = true;

        var controller = typeof AbortController === 'function' ? new AbortController() : null;
        var lang = document.documentElement.lang || 'en';
        var SECTIONS = ['work', 'about', 'engineering', 'studies', 'opensource', 'references'];

        function register(tool) {
          function fallback() {
            try {
              Promise.resolve(mc.registerTool(tool)).catch(function () {});
            } catch (error) {}
          }
          try {
            var result = controller ? mc.registerTool(tool, { signal: controller.signal }) : mc.registerTool(tool);
            if (result && typeof result.catch === 'function') result.catch(fallback);
          } catch (error) {
            fallback();
          }
        }

        function catalog() {
          return fetch('/mcp/catalog.json', { headers: { Accept: 'application/json' } })
            .then(function (response) {
              if (!response.ok) throw new Error('catalog unavailable');
              return response.json();
            });
        }

        register({
          name: 'go_to_section',
          description: 'Scroll the landing page to one section: work, about, engineering, studies, opensource or references.',
          inputSchema: {
            type: 'object',
            properties: {
              section: { type: 'string', enum: SECTIONS, description: 'Section id to scroll to.' }
            },
            required: ['section'],
            additionalProperties: false
          },
          execute: function (args) {
            var section = args && args.section;
            if (SECTIONS.indexOf(section) === -1) return { ok: false, error: 'Unknown section: ' + section };
            var target = document.getElementById(section);
            if (!target) {
              location.href = '/' + lang + '/#' + section;
              return { ok: true, navigated: true, url: location.href };
            }
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', '#' + section);
            return { ok: true, section: section };
          }
        });

        register({
          name: 'list_projects',
          description: 'List every featured case study and secondary package with its id, name and canonical URL.',
          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
          execute: function () {
            return catalog().then(function (data) {
              return {
                ok: true,
                count: data.projects.length,
                projects: data.projects.map(function (project) {
                  return { id: project.id, name: project.name, url: project.url || null, tier: project.tier };
                })
              };
            });
          }
        });

        register({
          name: 'open_project',
          description: 'Navigate to the case study of one project, by id or name (for example "trustsight").',
          inputSchema: {
            type: 'object',
            properties: {
              id: { type: 'string', description: 'Project id, e.g. "trustsight".' }
            },
            required: ['id'],
            additionalProperties: false
          },
          execute: function (args) {
            var wanted = String((args && args.id) || '').trim().toLowerCase();
            if (!wanted) return { ok: false, error: 'Missing required argument "id".' };
            return catalog().then(function (data) {
              var project = data.projects.filter(function (item) {
                return item.id.toLowerCase() === wanted || item.name.toLowerCase() === wanted;
              })[0];
              if (!project) return { ok: false, error: 'No project with id ' + wanted };
              if (!project.url) return { ok: false, error: project.name + ' has no case study page', links: project.links };
              location.href = project.url;
              return { ok: true, navigated: true, url: project.url };
            });
          }
        });

        register({
          name: 'read_summary',
          description: 'Return the site summary an agent should read first (llms.txt), with the canonical URLs of the main sections.',
          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
          execute: function () {
            return fetch('/llms.txt', { headers: { Accept: 'text/plain' } })
              .then(function (response) {
                return response.ok ? response.text() : '';
              })
              .then(function (text) {
                return { ok: Boolean(text), url: location.origin + '/llms.txt', text: text };
              });
          }
        });
      })();
    </script>
  </body>
</html>
